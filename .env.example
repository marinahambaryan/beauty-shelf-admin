# Copy to .env.local. These are public client values, the same ones the app ships with.
# Do not add a service-role key: the console doesn't use one. Access is enforced in the
# database, and account actions run in the admin-users Edge Function.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
